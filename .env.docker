APP_ENV=development
HTTP_ADDR=:8000
REDIS_KEY_PREFIX=unik:v1:
SECRET_KEY=local-docker-secret-change-in-production
ACCESS_TOKEN_TTL=24h
COOKIE_SECURE=false
WEB_DIR=app
SHUTDOWN_TIMEOUT=10s
DIRECTIONS_CACHE_TTL=15m
NEWS_CACHE_TTL=2m
SUMMARY_CACHE_TTL=1m
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=5m
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_WINDOW=10m
RATE_LIMIT_FAIL_OPEN=true
DEFAULT_ADMISSIONS_LOGIN=admin@unik.edu
DEFAULT_ADMISSIONS_PASSWORD=admin
DEFAULT_ANALYST_LOGIN=prepod@unik.edu
DEFAULT_ANALYST_PASSWORD=123456
